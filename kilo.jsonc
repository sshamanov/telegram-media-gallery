{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "model": "deepseek/deepseek-chat",
  "disabled_providers": [
    "myllmproxy"
  ],
  "enabled_providers": [
    "deepseek",
    "openai",
    "anthropic",
    "openrouter",
    "huggingface"
  ],
  "experimental": {
    "openTelemetry": false
  },
  "permission": {
    "external_directory": "deny",
    "bash": "allow",
    "edit": {
      "src/**": "allow",
      "public/**": "allow",
      "tmp/**": "allow",
      "temp/**": "allow",
      "*.md": "allow",
      "*.json": "allow",
      "*.ts": "allow",
      "*.svelte": "allow",
      "*.css": "allow",
      "*.html": "allow",
      "*.webmanifest": "allow",
      ".kilo/**": "allow",
      "node_modules/**": "deny",
      "src-reference/**": "deny",
      ".env": "deny"
    }
  }
}
