{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "model": "deepseek/deepseek-chat",
  "disabled_providers": [
    "myllmproxy"
  ],
  "enabled_providers": [
    "deepseek",
    "openai",
    "anthropic",
    "openrouter",
    "huggingface"
  ],
  "agent": {
    "code": {
      "model": "deepseek/deepseek-chat",
      "temperature": 0.1,
      "permission": {
        "edit": {
          ".kilo/status.md": "allow"
        }
      }
    },
    "plan": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "temperature": 0.1,
      "permission": {
        "edit": {
          ".kilo/status.md": "allow"
        }
      }
    },
    "debug": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "temperature": 0.0
    },
    "ask": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "temperature": 0.2
    },
    "orchestrator": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "temperature": 0.1
    }
  },
  "experimental": {
    "openTelemetry": false
  },
  "permission": {
    "external_directory": "deny",
    "bash": "allow",
    "edit": {
      ".kilo/status.md": "allow",
      "**/.kilo/status.md": "allow",
      "src/**": "allow",
      "public/**": "allow",
      "tmp/**": "allow",
      "temp/**": "allow",
      "*.md": "allow",
      "*.json": "allow",
      "*.ts": "allow",
      "*.svelte": "allow",
      "*.css": "allow",
      "*.html": "allow",
      "*.webmanifest": "allow",
      ".kilo/**": "allow",
      "node_modules/**": "deny",
      "src-reference/**": "deny",
      ".env": "deny"
    }
  }
}
