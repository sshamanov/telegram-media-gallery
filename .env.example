# Get these from https://my.telegram.org
# Used by `npm run dev` (build-time). The Docker image reads TELEGRAM_API_ID /
# TELEGRAM_API_HASH at runtime instead.
VITE_TELEGRAM_API_ID=
VITE_TELEGRAM_API_HASH=

# Use mock adapter instead of real Telegram API (for development/testing)
# Valid values: true, 1, True, TRUE or false, 0, False, FALSE
# VITE_USE_MOCK_ADAPTER=0

# Log available thumbnail/image sizes for debugging (development only)
# Valid values: true, 1, True, TRUE or false, 0, False, FALSE
# VITE_DEBUG_MEDIA_SIZES=0
