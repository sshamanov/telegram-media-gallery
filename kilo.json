{
  "model": "deepseek/deepseek-chat",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "agent": {
    "code": {
      "model": "deepseek/deepseek-chat",
      "reasoning": "off"
    },
    "plan": {
      "model": "anthropic/claude-sonnet-4-6",
      "reasoning": "medium"
    },
    "debug": {
      "model": "anthropic/claude-sonnet-4-6",
      "reasoning": "medium"
    },
    "ask": {
      "model": "anthropic/claude-sonnet-4-6",
      "reasoning": "medium"
    }
  },
  "permission": {
    "external_directory": "deny",
    "bash": "allow",
    "edit": {
      "src/**": "allow",
      "public/**": "allow",
      "tmp/**": "allow",
      "temp/**": "allow",
      "*.md": "allow",
      "*.json": "allow",
      "*.ts": "allow",
      "*.svelte": "allow",
      "*.css": "allow",
      "*.html": "allow",
      "*.webmanifest": "allow",
      ".kilo/**": "allow",
      "node_modules/**": "deny",
      "src-reference/**": "deny",
      ".env": "deny"
    }
  }
}
