{
  "name": "telegram-gallery",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:install-browsers": "playwright install chromium",
    "test:short": "playwright test --config=playwright.config.ts --grep \"@short\" --project=desktop-chrome",
    "test:long": "playwright test --config=playwright.config.ts --grep \"@long\" --project=desktop-chrome",
    "test:offline-shell": "playwright test --config=playwright.config.ts tests/e2e/long/offline.spec.ts --project=desktop-chrome",
    "test:all": "playwright test --config=playwright.config.ts",
    "test:ui": "playwright test --config=playwright.config.ts --grep \"@short\" --project=desktop-chrome",
    "test:visual": "echo 'Visual regression tests would use Playwright screenshot comparison'"
  },
  "dependencies": {
    "@mtcute/web": "^0.29.6",
    "photoswipe": "^5.4.4",
    "qrcode": "^1.5.4",
    "svelte": "^5.38.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
